# Copy this file to .env and fill only the credentials for platforms you use.
OPENAI_API_KEY=

# Meta / Instagram Graph API
INSTAGRAM_TOKEN=
INSTAGRAM_ACCOUNT_ID=
# Optional. Leave blank for automatic selection based on the token type.
INSTAGRAM_API_HOST=

# Cloudinary video hosting for Instagram Reels.
# Signed uploads are recommended. Alternatively, set CLOUDINARY_UPLOAD_PRESET.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_FOLDER=glimpse-of-thoughts/reels

# Facebook Pages Graph API
FACEBOOK_TOKEN=
FACEBOOK_PAGE_ID=

# Threads Graph API
THREADS_TOKEN=
THREADS_USER_ID=

# X/Twitter OAuth 1.0a (required for image uploads and posting)
TWITTER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# Pinterest API
PINTEREST_TOKEN=
PINTEREST_BOARD_ID=

# Public HTTPS base URLs. Instagram, Threads, and Pinterest cannot ingest localhost paths.
PUBLIC_IMAGE_BASE_URL=
# Leave this blank when Cloudinary is configured; Cloudinary URLs are used automatically.
PUBLIC_VIDEO_BASE_URL=
